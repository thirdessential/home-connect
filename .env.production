# Loaded by Expo CLI only for production bundles (release builds / export:embed,
# NODE_ENV=production) and takes precedence over .env. Keeps a local
# `./gradlew assembleRelease` from shipping the LAN dev backend (.env sets
# "development" for `expo start`). See lib/httpMethods.ts.
EXPO_PUBLIC_MY_TERRACE_APP_BACKEND=live
