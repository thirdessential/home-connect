{
  "expo": {
    "name": "My Terrace App",
    "slug": "home-connect",
    "version": "1.0.0",
    "scheme": "homeconnect",
    "icon": "./assets/images/icon.png",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c7db0351-ff33-4927-8888-8c52e6218946"
      }
    },
    "owner": "ganesh3rde",
    "android": {
      "package": "com.terrace.myapp",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "bundleIdentifier": "com.terrace.myapp"
    }
  }
}